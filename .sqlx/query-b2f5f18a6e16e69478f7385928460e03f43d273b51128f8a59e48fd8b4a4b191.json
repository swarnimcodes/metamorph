  "query": "select g.id, g.name, g.chain, g.address, g.city, g.verified, ug.is_default\n             from user_gyms ug\n             join gyms g on g.id = ug.gym_id\n            where ug.user_id = $1 and g.deleted_at is null\n            order by ug.is_default desc, g.name",
