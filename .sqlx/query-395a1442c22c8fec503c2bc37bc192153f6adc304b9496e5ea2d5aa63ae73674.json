  "query": "select c.id as \"id!\", c.name as \"name!\", c.kind as \"kind!: ExerciseKind\"\n             from exercises e\n             join exercises c on c.id = coalesce(e.merged_into_id, e.id)\n            where e.id = $1 and e.deleted_at is null\n              and (e.status = 'official' or e.created_by = $2)",
