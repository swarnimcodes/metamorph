DATABASE_URL=postgres://postgres@localhost/metamorph
JWT_SECRET=change-me-to-a-long-random-string
# Enables POST /auth/dev-login. Never set this in production.
DEV_LOGIN=false
BIND_ADDR=127.0.0.1:3000
# ACCESS_TOKEN_TTL_SECS=3600

# Google sign-in. Comma-separated OAuth client ids whose ID tokens are accepted
# (the web client now, the Android client later). Unset disables the routes.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com

# Browser origins allowed to call the API, comma-separated. Needed for the web
# app whenever DEV_LOGIN is off; with DEV_LOGIN on and this unset, CORS is permissive.
# CORS_ORIGINS=http://localhost:1420
