{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metamorph",
  "version": "0.1.8",
  "identifier": "com.smarniw.metamorph",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Metamorph",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "HealthcareFitness",
    "shortDescription": "Gym workout tracker",
    "longDescription": "Log workouts, sets and body weight, and follow your progress. Signs in with Google and syncs with your Metamorph account.",
    "copyright": "Copyright (c) 2026 Swarnim B",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "homepage": "https://metamorph.smarniw.com"
  },
  "mainBinaryName": "metamorph"
}
