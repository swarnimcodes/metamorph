# The Android app is bundled, so its API lives at an absolute address (see src-tauri/tauri.android.conf.json).
VITE_API_URL=https://metamorph.smarniw.com/api

# Browser sign-in for phones without Google Play services (GrapheneOS and similar). The OAuth client is of Google's
# "Android" type for com.smarniw.metamorph with "Enable custom URI scheme" on. The id is public. The API must list it in
# GOOGLE_CLIENT_IDS.
VITE_GOOGLE_ANDROID_CLIENT_ID=653482355052-oi3la44e7eta0nejd9hq6c4lt5dfsst4.apps.googleusercontent.com
