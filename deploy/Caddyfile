# One origin for everything: the web app is static files, the API lives under /api.
# Replace the hostname if you use a different one. Caddy gets and renews the HTTPS certificate itself.
metamorph.smarniw.com {
	encode zstd gzip

	# /api/workouts -> the API sees /workouts (the prefix is stripped)
	handle_path /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# Everything else is the single-page app (hash routing, so any path falls back to index.html).
	handle {
		root * /var/www/metamorph
		try_files {path} /index.html
		file_server
	}

	# Built assets have hashed names and never change.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
