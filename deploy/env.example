# Copy to /etc/metamorph/env on the server (owner root, group metamorph, mode 640).

# Postgres over its unix socket; the service user "metamorph" is also the database role (peer auth, no password).
DATABASE_URL=postgres://metamorph@localhost/metamorph?host=/var/run/postgresql

# Generate with: openssl rand -hex 32   (never reuse the development value)
JWT_SECRET=replace-me

BIND_ADDR=127.0.0.1:3000

# The binary carries its migrations and applies them at startup.
RUN_MIGRATIONS=true

# The web client id from Google Cloud Console (not a secret).
GOOGLE_CLIENT_IDS=replace-me.apps.googleusercontent.com

# Same-origin deployment needs no CORS; list origins only if another site must call the API.
# CORS_ORIGINS=https://metamorph.smarniw.com

# Never enable this on a server.
DEV_LOGIN=false

RUST_LOG=metamorph_api=info,tower_http=warn
